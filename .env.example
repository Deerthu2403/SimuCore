# Copy to .env and adjust. Never commit real credentials.
SIMUCORE_ENV=development
SIMUCORE_LOG_LEVEL=INFO
# simulated = built-in synthetic data; bank_services = the running banking-sim services
SIMUCORE_TELEMETRY_ADAPTER=simulated
SIMUCORE_TELEMETRY_INTERVAL_S=1.0
SIMUCORE_RANDOM_SEED=42
SIMUCORE_INCIDENT_RATE=0.0003
SIMUCORE_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
SIMUCORE_DATABASE_URL=postgresql+asyncpg://simucore:YOUR_PASSWORD@localhost:5432/simucore
SIMUCORE_PROMETHEUS_URL=http://localhost:9090

# docker compose: every password is required and must be your own random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_USER=simucore
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
