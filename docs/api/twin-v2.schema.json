            "type": "object"
          },
          "by_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/$defs/ComponentType"
            },
            "title": "By Type",
            "type": "object"
          },
          "links": {
            "title": "Links",
            "type": "integer"
          },
          "links_failed": {
            "title": "Links Failed",
            "type": "integer"
          },
          "needs_attention": {
            "description": "Ids, most serious first",
            "items": {
              "type": "string"
            },
            "title": "Needs Attention",
            "type": "array"
          }
        },
        "required": [
          "overall",
          "components",
          "by_status",
          "by_type",
          "links",
          "links_failed",
          "needs_attention"
        ],
        "title": "Summary",
        "type": "object"
      },
      "TwinMeta": {
        "properties": {
          "api_version": {
            "default": "2.0",
            "title": "Api Version",
            "type": "string"
          },
          "twin_id": {
            "default": "simucore-bank",
            "title": "Twin Id",
            "type": "string"
          },
          "run_id": {
            "description": "Changes when the twin process restarts",
            "title": "Run Id",
            "type": "string"
          },
          "version": {
            "description": "Grows with every change",
            "title": "Version",
            "type": "integer"
          },
          "structure_version": {
            "description": "Grows when components or links are added/removed",
            "title": "Structure Version",
            "type": "integer"
          },
          "sync": {
            "enum": [
              "live",
              "stale",
              "waiting"
            ],
            "title": "Sync",
            "type": "string"
          },
          "origin": {
            "anyOf": [
              {
                "enum": [
                  "measured",
                  "synthetic"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "last_observation_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the values shown were measured",
            "title": "Last Observation At"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "version",
          "structure_version",
          "sync",
          "origin",
          "last_observation_at",
          "generated_at"
        ],
        "title": "TwinMeta",
        "type": "object"
      }
    },
    "properties": {
      "meta": {
        "$ref": "#/$defs/TwinMeta"
      },
      "summary": {
        "$ref": "#/$defs/Summary"
      },
      "components": {
        "items": {
          "$ref": "#/$defs/ComponentView"
        },
        "title": "Components",
        "type": "array"
      },
      "links": {
        "items": {
          "$ref": "#/$defs/LinkView"
        },
        "title": "Links",
        "type": "array"
      }
    },
    "required": [
      "meta",
      "summary",
      "components",
      "links"
    ],
    "title": "TwinView",
    "type": "object"
  },
